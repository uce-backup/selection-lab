<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>programming</groupId>
  <artifactId>selection-lab</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Laboratorio: estructuras de selección</name>

  <properties>
    <!-- Versión de Java del proyecto. 25 es la mínima: SelectionApp usa la clase java.lang.IO. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Clase que se ejecuta con "mvn compile exec:java" y con "Run" en el IDE. -->
    <exec.mainClass>programming.selection.SelectionApp</exec.mainClass>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencies>
    <!-- JUnit: biblioteca para las pruebas automáticas. Solo se usa en src/test. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Detiene la compilación con un mensaje claro si el JDK instalado es anterior a Java 25. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>require-java-25</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>Este proyecto necesita Java 25 o superior (usa java.lang.IO).</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Compila el código con la versión de Java indicada en maven.compiler.release. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <!-- Ejecuta las pruebas con "mvn test". -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <!-- Ejecuta la clase principal con "mvn compile exec:java". -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
